<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fondo_login"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="36dp"
    android:paddingBottom="18dp">

    <!-- Identidad superior -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NOTASAPP  /  COLECCIÓN"
        android:textColor="#000000"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.10"/>

    <!-- Título principal -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:text="Mis historias."
        android:textColor="#000000"
        android:textSize="29sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="Un lugar para volver a cada pensamiento."
        android:textColor="#CB000000"
        android:textSize="14sp"/>

    <!-- Cantidad de notas -->

    <TextView
        android:id="@+id/tvCantidadNotas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:text="Mis notas"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textStyle="bold"/>

    <!-- Indicador de carga -->

    <ProgressBar
        android:id="@+id/progresoListado"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="25dp"
        android:indeterminateTint="#000000"
        android:visibility="gone"/>

    <!-- Mensajes informativos -->

    <TextView
        android:id="@+id/tvEstadoListado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:padding="16dp"
        android:gravity="center"
        android:textColor="#000000"
        android:textSize="14sp"
        android:visibility="gone"/>

    <!-- Listado dinámico -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNotas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="vertical"/>

    <!-- Volver al Dashboard -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegresarListado"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Volver a mi espacio"
        android:textAllCaps="false"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        app:backgroundTint="#04172F"
        app:cornerRadius="16dp"/>

</LinearLayout>