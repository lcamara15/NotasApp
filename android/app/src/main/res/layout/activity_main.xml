<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_login">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="46dp"
            android:paddingBottom="35dp">

            <!-- Identidad superior -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NOTASAPP"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦  TU ESPACIO"
                    android:textColor="#03070B"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"/>

            </LinearLayout>

            <!-- Encabezado principal -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="47dp"
                android:text="Un rincón para\n tus ideas."
                android:textColor="#000000"
                android:textSize="34sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Pequeños pensamientos, grandes historias."
                android:textColor="#95020305"
                android:textSize="14sp"/>

            <!-- Tarjeta de acceso -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="7dp"
                app:strokeColor="#E5ECF6"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="25dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Qué bonito verte\nde nuevo."
                        android:textColor="#304F7A"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="3dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Ingresa a tu espacio y continúa desde donde lo dejaste."
                        android:textColor="#8393AA"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"/>

                    <!-- Correo electrónico -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:hint="Correo electrónico"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="#7596C5"
                        app:boxStrokeWidth="1dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:hintTextColor="#587DAD">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCorreo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:singleLine="true"
                            android:textSize="15sp"
                            android:textColor="#304F7A"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Contraseña -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="Contraseña"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="#7596C5"
                        app:boxStrokeWidth="1dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:hintTextColor="#587DAD"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#7290B6">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etContrasena"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textSize="15sp"
                            android:textColor="#304F7A"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Mensajes de validación -->

                    <TextView
                        android:id="@+id/tvMensaje"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:textColor="#C15B68"
                        android:textSize="13sp"
                        android:visibility="gone"/>

                    <!-- Indicador de carga -->

                    <ProgressBar
                        android:id="@+id/progresoLogin"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="18dp"
                        android:indeterminateTint="#587DAD"
                        android:visibility="gone"/>

                    <!-- Botón de acceso -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIniciarSesion"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="26dp"
                        android:text="Entrar a mis notas"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#466B9F"
                        app:cornerRadius="18dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Mensaje inferior -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="Un lugar tranquilo para guardar todo lo que importa. ✦"
                android:textColor="#93A3BB"
                android:textSize="12sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>