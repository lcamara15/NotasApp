<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fondo_login">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"
            android:paddingTop="42dp"
            android:paddingBottom="38dp">

            <!-- Identidad superior -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="N O T A S A P P"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦  MI ESPACIO"
                    android:textColor="#000000"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- Bienvenida personalizada -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:text="UN NUEVO MOMENTO PARA TI"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <TextView
                android:id="@+id/tvBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="¡Hola de nuevo!"
                android:textColor="#000000"
                android:textSize="31sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tu pequeño espacio de ideas te esperaba."
                android:textColor="#98000000"
                android:textSize="14sp"/>

            <!-- Portada decorativa -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:background="@drawable/fondo_portada"
                android:orientation="vertical"
                android:padding="26dp"
                android:elevation="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="✦  MI DIARIO DIGITAL"
                        android:textColor="#E8F0FC"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10"/>

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/fondo_circulo"
                        android:gravity="center"
                        android:text="✎"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Un espacio para\ntodo lo que imaginas."
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="5dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Ideas, recuerdos y pensamientos que merecen quedarse contigo."
                    android:textColor="#E5EEFA"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="27dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="27dp"
                        android:layout_height="4dp"
                        android:background="#FFFFFF"/>

                    <View
                        android:layout_width="9dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="7dp"
                        android:background="#BBD0EB"/>

                    <View
                        android:layout_width="9dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="7dp"
                        android:background="#BBD0EB"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Funcionalidades disponibles -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="37dp"
                android:text="Tu espacio, tus momentos"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="¿Por dónde te gustaría comenzar?"
                android:textColor="#AB000000"
                android:textSize="13sp"/>

            <!-- Tarjeta: crear nota -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="23dp"
                app:cardElevation="3dp"
                app:strokeColor="#E5ECF5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✎  Escribir algo nuevo"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Convierte tus pensamientos en una nueva nota personal."
                        android:textColor="#CF000000"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCrearNota"
                        android:layout_width="match_parent"
                        android:layout_height="51dp"
                        android:layout_marginTop="21dp"
                        android:text="Crear nota"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#04172F"
                        app:cornerRadius="16dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta: consultar notas -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="23dp"
                app:cardElevation="3dp"
                app:strokeColor="#E5ECF5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="▤  Volver a mis notas"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Explora tus ideas y vuelve a leer aquello que guardaste."
                        android:textColor="#C9000000"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConsultarNotas"
                        android:layout_width="match_parent"
                        android:layout_height="51dp"
                        android:layout_marginTop="21dp"
                        android:text="Explorar mis notas"
                        android:textColor="#000000"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#E4ECF8"
                        app:cornerRadius="16dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Separador de cuenta -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="33dp"
                android:background="#C9D6EA"/>

            <!-- Botón para cerrar sesión -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginTop="20dp"
                android:text="↪  Cerrar sesión"
                android:textColor="#17365D"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#F4F7FD"
                app:cornerRadius="17dp"
                app:strokeColor="#B8CBE4"
                app:strokeWidth="1dp"/>

            <!-- Mensaje inferior -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Tus palabras también merecen un lugar bonito. ✦"
                android:textColor="#C8000000"
                android:textSize="12sp"
                android:gravity="center"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>